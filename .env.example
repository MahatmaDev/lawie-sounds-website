# ============================================================
# LAWIE SOUNDS — REQUIRED ENVIRONMENT VARIABLES
# Copy this file to .env for local dev (never commit .env)
# Set ALL of these in Vercel → Project Settings → Environment Variables
# ============================================================

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://hwztlypkzbxmggldfdhc.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here     # NEVER expose publicly

# ── Auth (JWT signing) ──────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-in-production

# ── Admin credentials ───────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password

# ── Manager credentials (optional) ──────────────────────────
# MANAGER_USERNAME=manager
# MANAGER_PASSWORD=change-this-strong-password

# ── CORS: your exact Vercel frontend URL ────────────────────
FRONTEND_URL=https://lawie-sounds-website.vercel.app

# ── WhatsApp push notifications (optional, via CallMeBot) ───
# Setup: WhatsApp +34 644 38 11 72 → send "I allow callmebot to send me messages"
# ADMIN_PHONE=254703925826
# CALLMEBOT_APIKEY=your-callmebot-api-key

# ── Cloud media storage (Cloudflare R2) — plan phase P3 ─────
# Leave these unset and nothing changes: the gallery keeps using Supabase
# Storage exactly as it does today, and /api/admin/media/* answers 503.
#
# R2 dashboard → R2 → Manage API tokens → Create API token (Object Read & Write)
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto                       # R2 requires the literal 'auto'
# R2_BUCKET_MASTERS=lawie-masters      # private. Never make this bucket public.
# R2_BUCKET_DERIVATIVES=lawie-derivatives
# R2_PUBLIC_BASE=https://media.lawiesounds.com   # the derivatives bucket's CDN domain
#
# How long an original is kept before the retention sweep may purge it. After
# that the largest surviving copy is the 2048px web rendition (photos) or the
# 720p preview (video). Set to 0 to keep every master forever.
# MASTER_RETENTION_MONTHS=12
# MEDIA_MAX_BYTES=536870912            # 512 MB upload ceiling
