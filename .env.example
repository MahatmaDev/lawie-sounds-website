# ============================================================
# LAWIE SOUNDS — REQUIRED ENVIRONMENT VARIABLES
# Copy this file to .env for local dev (never commit .env)
# Set ALL of these in Vercel → Project Settings → Environment Variables
# ============================================================

# ── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://hwztlypkzbxmggldfdhc.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here     # NEVER expose publicly

# ── Auth (JWT signing) ──────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-in-production

# ── Admin credentials ───────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password

# ── Manager credentials (optional) ──────────────────────────
# MANAGER_USERNAME=manager
# MANAGER_PASSWORD=change-this-strong-password

# ── CORS: your exact Vercel frontend URL ────────────────────
FRONTEND_URL=https://lawie-sounds-website.vercel.app

# ── WhatsApp push notifications (optional, via CallMeBot) ───
# Setup: WhatsApp +34 644 38 11 72 → send "I allow callmebot to send me messages"
# ADMIN_PHONE=254703925826
# CALLMEBOT_APIKEY=your-callmebot-api-key

# ── Private album media storage (AWS S3) ────────────────────
# Configure these for BOTH the API (Vercel) and the media worker.
# The worker must be running to process uploads; until then, photos remain
# queued and albums cannot be published.
# Keep both buckets private with Block Public Access enabled.
MEDIA_S3_REGION=af-south-1
MEDIA_S3_ACCESS_KEY_ID=your-s3-access-key-id
MEDIA_S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
MEDIA_S3_BUCKET_MASTERS=lawie-masters
MEDIA_S3_BUCKET_DERIVATIVES=lawie-derivatives
# Leave the endpoint unset for AWS S3. For MinIO or another compatible store:
# MEDIA_S3_ENDPOINT=https://your-s3-compatible-endpoint
# MEDIA_S3_PATH_STYLE=true
#
# The worker also needs SUPABASE_URL and SUPABASE_SERVICE_KEY above.
# Legacy R2_* variables remain supported for existing deployments.
#
# How long an original is kept before the retention sweep may purge it. The
# 2048px photo rendition or 720p video preview remains available afterward.
# Set to 0 to keep every master forever.
MASTER_RETENTION_MONTHS=12
MEDIA_MAX_BYTES=536870912                 # 512 MB upload ceiling
