# =============================================================================
# LAWIE SOUNDS — ENVIRONMENT VARIABLES (template)
#
# Copy to backened/.env for local development, and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
#
# Vercel env changes only take effect on a NEW deployment — redeploy after
# editing them, or the running function keeps the old values.
#
# This file is committed. It must never contain a real value.
# =============================================================================

NODE_ENV=development
PORT=5000

# --- Supabase -----------------------------------------------------------------
# SUPABASE_SERVICE_KEY bypasses Row Level Security. It is the only reason the
# API can write to tables that anon cannot. Never expose it to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Auth ---------------------------------------------------------------------
# JWT_SECRET signs admin session tokens. Rotating it logs everyone out.
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d

# Admin and manager logins. The manager role is blocked from employees and
# payroll server-side, not just hidden in the dashboard.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
MANAGER_USERNAME=manager
MANAGER_PASSWORD=change-me

# The developer, kept separate from the owner on purpose. The work log records
# development delivered and the company's acceptance of it — which only means
# something if the person who did the work is not the person who signs it off.
# Without these set there is no developer role, and the work log is owner-only.
DEVELOPER_USERNAME=developer
DEVELOPER_PASSWORD=change-me

# The names each person is greeted by on their dashboard. Optional — these
# default to the current team, so leaving them unset is fine. Set them when
# someone joins or leaves, so a name change needs no code edit and no deploy.
ADMIN_NAME=Lawrence Gichaga
MANAGER_NAME=Nyambura
DEVELOPER_NAME=Developer

# --- Reviews ------------------------------------------------------------------
# REVIEW_HASH_SALT salts the HMAC of a reviewer's IP address. We store only the
# hash, never the address: enough to notice one device submitting ten reviews,
# not enough to identify anyone.
#
# SET THIS EXPLICITLY. It falls back to JWT_SECRET, which works but couples two
# unrelated secrets — rotating JWT_SECRET would silently orphan every stored
# submitter hash, so past submissions would stop correlating with new ones.
REVIEW_HASH_SALT=generate-a-second-long-random-string

# Successful review submissions allowed per IP per hour. Failed validation
# attempts are NOT counted, so a client fumbling the form is never locked out.
# Default 3 if unset.
REVIEW_RATE_LIMIT=3

# --- Public site URL ----------------------------------------------------------
# Used for CORS and for the dashboard links inside admin notifications.
FRONTEND_URL=https://your-site.vercel.app

# --- WhatsApp admin alerts (CallMeBot, optional) -------------------------------
# Both must be set or notifications are skipped silently.
# Activate once: WhatsApp +34 644 38 11 72, send "I allow callmebot to send me messages"
ADMIN_PHONE=
CALLMEBOT_APIKEY=

# --- Contact ------------------------------------------------------------------
WHATSAPP_NUMBER=254700000000
ADMIN_EMAIL=you@example.com

# --- CORS ---------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,https://your-domain.com
