{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "frontend/**", "use": "@vercel/static" },
    { "src": "IMAGES/**", "use": "@vercel/static" },
    { "src": "Gallery/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "continue": true, "headers": {
      "X-Content-Type-Options": "nosniff",
      "X-Frame-Options": "DENY",
      "Referrer-Policy": "strict-origin-when-cross-origin"
    }},
    { "src": "/admin/(.*)", "continue": true, "headers": {
      "X-Frame-Options": "DENY",
      "X-Content-Type-Options": "nosniff",
      "Referrer-Policy": "strict-origin-when-cross-origin",
      "Cache-Control": "no-store, no-cache, must-revalidate"
    }},
    { "src": "/icons/(.*)", "continue": true, "headers": {
      "Cache-Control": "public, max-age=31536000, immutable"
    }},
    { "src": "/IMAGES/(.*)", "continue": true, "headers": {
      "Cache-Control": "public, max-age=31536000, immutable"
    }},
    { "src": "/Gallery/(.*)", "continue": true, "headers": {
      "Cache-Control": "public, max-age=31536000, immutable"
    }},
    { "src": "/(.*\\.(?:js|css))", "continue": true, "headers": {
      "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
    }},

    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/health", "dest": "/api/index.js" },
    { "src": "/IMAGES/(.*)", "dest": "/IMAGES/$1" },
    { "src": "/Gallery/(.*)", "dest": "/Gallery/$1" },
    { "src": "/", "dest": "/frontend/index.html" },
    { "src": "/admin/?", "dest": "/frontend/admin/login.html" },
    { "src": "/(.*)", "dest": "/frontend/$1", "continue": true },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/frontend/404.html", "status": 404 }
  ]
}
